# Export any of these before `npm run dev`. Each one becomes a provider automatically.
# Keys from the environment are read at startup and never written to disk.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Optional: encrypts keys typed into the app. Without it, a random key is kept in data/master.key.
DEEPWORK_SECRET=

# Optional
PORT=5174
# DEEPWORK_DEMO_SPEED=1
