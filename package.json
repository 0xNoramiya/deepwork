{
  "name": "deepwork",
  "version": "0.1.0",
  "private": true,
  "description": "Give a crew of AI agents a mission and watch them work. A multi-agent workspace drawn as a paper-cut submarine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xNoramiya/deepwork.git"
  },
  "homepage": "https://github.com/0xNoramiya/deepwork#readme",
  "bugs": "https://github.com/0xNoramiya/deepwork/issues",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "llm",
    "agent-orchestration",
    "anthropic",
    "openai",
    "claude"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'src/**' --ignore 'data/**' --ignore 'workspace/**' server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "DEEPWORK_DEMO_SPEED=0 tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "openai": "^7.25.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "zustand": "^5.0.15"
  }
}
